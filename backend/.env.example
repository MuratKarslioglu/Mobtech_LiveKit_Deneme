# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Application
APP_LANGUAGE=tr
LOG_LEVEL=INFO

# Azure OpenAI / Azure AI Foundry — tek bir kaynak, üç ayrı deployment
# (chat/transcribe/tts), hepsi aynı endpoint/key'i paylaşır.
#   AZURE_OPENAI_ENDPOINT örn. https://<kaynak-adı>.services.ai.azure.com
#   AZURE_OPENAI_*_DEPLOYMENT — Azure portalındaki DEPLOYMENT adları (model adı
#   değil, ama genelde aynı/benzer isimdedir, örn. "gpt-5-mini", "gpt-4o-mini-transcribe", "tts")
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT=
AZURE_OPENAI_STT_DEPLOYMENT=
AZURE_OPENAI_TTS_DEPLOYMENT=
# Belge arama (retriever) için embedding deployment'ı — Azure portalında ayrıca
# oluşturulmalı (örn. model "text-embedding-3-small"). Boyutu deployment'ın
# modeliyle uyuşmalı; text-embedding-3-small=1536, text-embedding-3-large=3072.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Belge API'si (backend/app/api.py) — yüklenen dosyalar ve vector store için.
DOCUMENTS_DIR=data/uploads
DOCUMENTS_DB_PATH=data/documents.db
# Belge API'sinin CORS ile izin verdiği frontend origin'i.
FRONTEND_ORIGIN=http://localhost:3000

# Bir tool/LLM işlemi bu süreden (ms) uzun sürerse kullanıcıya bir ara mesaj
# söylenir (örn. "Hesaplamayı yapıyorum."). NOT: LiveKit'in konuşma kuyruğu
# bu mesajı asıl cevabın SpeechHandle'ının arkasına koyar (öncelik yok), bu
# yüzden eşik tipik LLM TTFT'sinin (~1.2-1.5sn) belirgin üstünde tutulmalı —
# aksi halde "düşünüyorum" mesajı neredeyse her turda, hatta bazen asıl
# cevaptan SONRA çalar. Bkz. app/config.py'deki not.
INTERIM_RESPONSE_THRESHOLD_MS=2500
