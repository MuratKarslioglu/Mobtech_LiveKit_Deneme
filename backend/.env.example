# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Gemini API
GOOGLE_API_KEY=

# Application
APP_LANGUAGE=tr
LOG_LEVEL=INFO

# Faster-Whisper (STT)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# Gemini model isimleri tek yerde tutulur, kod içine hardcode edilmez
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
